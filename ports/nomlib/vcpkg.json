{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "nomlib",
  "version-semver": "0.13.1",
  "maintainers": "Jeffrey Carpenter <1329364+i8degrees@users.noreply.github.com>",
  "description": "C++11 game engine",
  "homepage": "https://nomlib.479831.xyz/#",
  "documentation": "https://nomlib.479831.xyz/docs/#",
  "license": "BSD-2-Clause",
  "supports": "(osx & x64), ((linux & x64), (windows & x86 & static))",
  "builtin-baseline": "44819aa2a6c10e56065e2b0330e7d6c89d1d2574",
  "dependencies": [
    {
      "name": "librocket",
      "platform": "(osx & x64), ((linux & x64), (windows & x86 & static))",
      "version>=": "1.3.0.0"
    },
    {
      "name": "libsndfile",
      "features": [
        "external-libs"
      ],
      "platform": "(osx & x64), ((linux & x64), (windows & x86 & static))",
      "version>=": "1.2.2"
    },
    {
      "name": "openal-soft",
      "platform": "!osx & !windows",
      "version>=": "1.17.2"
    },
    {
      "name": "openal-soft",
      "platform": "windows & (x86 | x64)",
      "version>=": "1.17.2"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "platform": "osx | windows",
      "version>=": "2.0.4"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "features": [
        "wayland"
      ],
      "platform": "!osx & !windows",
      "version>=": "2.0.4"
    },
    {
      "name": "sdl2-image",
      "default-features": false,
      "features": [
        "tiff"
      ],
      "platform": "(osx & x64), ((linux & x64), (windows & x86 & static))",
      "version>=": "2.0.1"
    },
    {
      "name": "sdl2-ttf",
      "default-features": false,
      "platform": "(osx & x64), ((linux & x64), (windows & x86 & static))",
      "version>=": "2.0.14"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "overrides": [
    {
      "name": "sdl2",
      "version": "2.32.10"
    },
    {
      "name": "sdl2-image",
      "version": "2.8.12"
    },
    {
      "name": "sdl2-ttf",
      "version": "2.24.0"
    },
    {
      "name": "openal-soft",
      "version": "1.25.1#1"
    }
  ]
}
