{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "nomlib",
  "version-semver": "0.14.0",
  "port-version": 2,
  "maintainers": "Jeffrey Carpenter <1329364+i8degrees@users.noreply.github.com>",
  "description": "C++11 game engine",
  "homepage": "https://nomlib.479831.xyz/#",
  "documentation": "https://nomlib.479831.xyz/docs/#",
  "license": "BSD-2-Clause",
  "supports": "(osx & x64), ((linux & x64), (windows & x64))",
  "dependencies": [
    {
      "name": "librocket",
      "platform": "(osx & x64), ((linux & x64), (windows & x64))"
    },
    {
      "name": "libsndfile",
      "features": [
        "external-libs"
      ],
      "platform": "(osx & x64), ((linux & x64), (windows & x64))"
    },
    {
      "name": "openal-soft",
      "platform": "!osx & !windows"
    },
    {
      "name": "openal-soft",
      "platform": "windows & (x86 | x64)"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "platform": "osx | windows"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "features": [
        "wayland"
      ],
      "platform": "!osx & !windows"
    },
    {
      "name": "sdl2-image",
      "default-features": false,
      "features": [
        "tiff"
      ],
      "platform": "(osx & x64), ((linux & x64), (windows & x64))"
    },
    {
      "name": "sdl2-ttf",
      "default-features": false,
      "platform": "(osx & x64), ((linux & x64), (windows & x64))"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
